{
  "name": "Polarization Matrix Chamber \u2014 Mueller Measurement, Instrument Calibration & Physical-Realizability Review",
  "domain": "polarization-optics",
  "convention": {
    "stokesOrder": [
      "I",
      "Q",
      "U",
      "V"
    ],
    "rotationSign": 1,
    "angleBasis": "degrees, +CCW looking into beam",
    "vecMueller": "row-major (m00..m33); design X[i,4r+c]=a_i[r] g_i[c]"
  },
  "layers": {
    "intensity": {
      "file": "intensity-v1.csv",
      "version": "v1",
      "unit": "counts",
      "basis": "detector raw digital counts"
    },
    "state": {
      "file": "state-v1.csv",
      "version": "v1",
      "unit": "degree",
      "basis": "PSG/PSA optic kind + mechanical angle"
    },
    "dark": {
      "file": "dark-v1.csv",
      "version": "v1",
      "unit": "counts",
      "basis": "shutter-closed detector offset"
    },
    "instrument": {
      "file": "instrument-v1.csv",
      "version": "v1",
      "unit": "dimensionless",
      "basis": "per-state response gain, lab frame"
    },
    "wavelength": {
      "file": "wavelength-v1.csv",
      "version": "v1",
      "unit": "nm",
      "basis": "vacuum"
    },
    "reference": {
      "file": "reference-v1.csv",
      "version": "v1",
      "unit": "dimensionless",
      "basis": "canonical IQUV known Mueller"
    },
    "covariance": {
      "file": "covariance-v1.csv",
      "version": "v1",
      "unit": "counts^2",
      "basis": "detector covariance, diagonal v1"
    }
  },
